#!/bin/sh

set -e

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

# $2 is the previously configured version (empty on a fresh install).
case "$1" in
    configure)
        if [ -n "$2" ] && dpkg --compare-versions "$2" lt 3.4.0; then
            echo "What's new in 3.4.0: https://keen-pbr.fyi/docs/changelog/#v3-4-0"
        fi
        ;;
esac

if command -v systemctl >/dev/null 2>&1; then
    systemctl enable keen-pbr >/dev/null 2>&1 || true
    systemctl start keen-pbr >/dev/null 2>&1 || true
fi

exit 0
