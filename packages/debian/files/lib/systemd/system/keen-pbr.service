[Unit]
Description=keen-pbr policy-based routing daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Kernel modules for the iptables backend (multiport matching, statistic-based load balancing, connmark); not needed with nftables.
ExecStartPre=-/bin/sh -c 'command -v nft >/dev/null 2>&1 || modprobe -a xt_multiport xt_statistic xt_connmark'
ExecStart=/usr/sbin/keen-pbr --config /etc/keen-pbr/config.json --pid-file /var/run/keen-pbr.pid --log-target syslog service
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
