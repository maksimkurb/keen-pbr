[Unit]
Description=keen-pbr policy-based routing daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Kernel module for the iptables backend (not needed with nftables).
ExecStartPre=-/bin/sh -c 'command -v nft >/dev/null 2>&1 || modprobe xt_multiport'
ExecStart=/usr/sbin/keen-pbr --config /etc/keen-pbr/config.json --pid-file /var/run/keen-pbr.pid --log-target syslog service
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
