[Unit]
Description=keen-pbr policy-based routing daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Kernel modules for the iptables backend; the optional dnsmasq integration is
# installed by the daemon itself (dns.resolver_integration).
ExecStartPre=-/usr/lib/keen-pbr/dnsmasq.sh ensure-modules
ExecStart=/usr/sbin/keen-pbr --config /etc/keen-pbr/config.json --pid-file /var/run/keen-pbr.pid --log-target syslog service
ExecReload=/bin/kill -HUP $MAINPID
ExecStopPost=-/usr/lib/keen-pbr/dnsmasq.sh fallback
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
