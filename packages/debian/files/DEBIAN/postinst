#!/bin/sh

set -e

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

# keen-pbr does not edit the dnsmasq configuration on install: the dnsmasq
# integration is optional (dns.resolver_integration = "dnsmasq" in
# /etc/keen-pbr/config.json) and the daemon installs its conf-script entry
# itself (dnsmasq.sh activate) when it is enabled.  An existing setup keeps
# working after an upgrade.  To apply the recommended dnsmasq base config
# manually, run:
#   /usr/lib/keen-pbr/dnsmasq.sh install-defaults

if command -v systemctl >/dev/null 2>&1; then
    systemctl enable keen-pbr >/dev/null 2>&1 || true
    systemctl start keen-pbr >/dev/null 2>&1 || true
fi

exit 0
