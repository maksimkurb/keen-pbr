#!/bin/sh

set -e

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

cat <<'EOF'
keen-pbr has been removed.
The keen-pbr entry was removed from dnsmasq. If dnsmasq had no upstream DNS
server of its own, /etc/dnsmasq.d/keen-pbr.conf was left with the fallback
servers: replace them with your own or delete the file.
EOF

exit 0
