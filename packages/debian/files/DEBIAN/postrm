#!/bin/sh

set -e

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

cat <<'EOF'
keen-pbr has been removed.
The keen-pbr entry was removed from dnsmasq. If dnsmasq had no upstream DNS
server of its own, /etc/dnsmasq.conf was left with a marked block of fallback
servers: replace them with your own or delete the block.
EOF

# Created by the dnsmasq hook, not shipped by the package: it is ours alone,
# so purge removes it (the hook's uninstall already did when it could).
case "$1" in
    purge)
        rm -rf /etc/keen-pbr/dnsmasq.d
        ;;
esac

exit 0
