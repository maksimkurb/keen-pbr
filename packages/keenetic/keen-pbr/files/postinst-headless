#!/bin/sh

echo "keen-pbr-headless installation"
echo "--------------------------------"

mkdir -p /opt/usr/lib/keen-pbr

# Migrate from the removed dnsmasq integration: clean up the dnsmasq
# configuration and restore any servers that were managed by keen-pbr.
# This is idempotent and safe to call even if the integration was never used.
/opt/usr/lib/keen-pbr/migrate-dnsmasq.sh >/dev/null 2>&1 || true

echo ""
/opt/etc/init.d/S80keen-pbr start || echo "Failed to start keen-pbr service"
echo ""

echo "Installation complete!"
echo "Config path: /opt/etc/keen-pbr/config.json"
echo "Web API is unavailable in the headless version. Please use CLI to manage keen-pbr."

exit 0
