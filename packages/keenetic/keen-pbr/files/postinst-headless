#!/bin/sh

echo "keen-pbr-headless installation"
echo "--------------------------------"

mkdir -p /opt/usr/lib/keen-pbr

if [ "$PKG_UPGRADE" = "1" ] && ! grep -q '"version"' /opt/etc/keen-pbr/config.json 2>/dev/null; then
    echo "What's new in 3.4.0: https://keen-pbr.fyi/docs/changelog/#v3-4-0"
fi

# keen-pbr 3.3.x depended on dnsmasq, and opkg may have just removed it.
/opt/usr/lib/keen-pbr/upgrade-dnsmasq.sh postinst

echo ""
/opt/etc/init.d/S80keen-pbr start || echo "Failed to start keen-pbr service"
echo ""

echo "Installation complete!"
echo "Config path: /opt/etc/keen-pbr/config.json"
echo "Web API is unavailable in the headless version. Please use CLI to manage keen-pbr."

exit 0
