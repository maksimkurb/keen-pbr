#!/bin/sh

. /opt/etc/keen-pbr/defaults

ENABLED=yes
PROCS=$(basename "$KEEN_PBR")
PIDFILE="/opt/var/run/keen-pbr.pid"
ARGS="--config $CONFIG --pid-file $PIDFILE --log-target syslog ${KEEN_PBR_ARGS:-} service"
PREARGS=""
POSTCMD=""
DESC="keen-pbr"
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
IPSET_PROBE_SET="kpbr_probe_hash_net"
IPSET_COMPONENTS_MESSAGE="ipset kernel modules are not available. Make sure that you followed the installation process and installed all required components: Netfilter Subsystem Kernel Modules and Xtables-addons Extension Package for Netfilter."
KEENETIC_RCI_STARTUP_ATTEMPTS=15

log() {
    logger -s -t "keen-pbr" "$1"
}

log_error() {
    logger -s -t "keen-pbr" -p "user.err" "$1"
}

log_warn() {
    logger -s -t "keen-pbr" -p "user.warning" "WARNING: $1"
}

module_path_for() {
    local module="$1"

    printf '/lib/modules/%s/%s.ko\n' "$(uname -r)" "$module"
}

# Loaded modules always appear in sysfs.  HINT ("file:name") catches modules
# built into the firmware: present when the file lists that exact line, or,
# with an empty name, when the file exists.
kernel_module_present() {
    local module="$1" hint="$2" file name

    [ -d "${KERNEL_MODULE_SYSFS:-/sys/module}/$module" ] && return 0
    [ -n "$hint" ] || return 1
    file="${hint%:*}"
    name="${hint##*:}"
    if [ -z "$name" ]; then
        [ -e "$file" ]
    else
        grep -qx "$name" "$file" 2>/dev/null
    fi
}

# load_kernel_module LEVEL MODULE HINT EFFECT
# LEVEL: required (logs an error), optional (logs a warning) or probe (the
# caller reports the failure itself).  Already present modules are silent.
# Returns 0 when present or loaded, 1 when the .ko is missing, 2 when insmod
# fails.
load_kernel_module() {
    local level="$1" module="$2" hint="$3" effect="$4" path output

    kernel_module_present "$module" "$hint" && return 0

    path="$(module_path_for "$module")"
    if [ ! -f "$path" ]; then
        report_module_failure "$level" \
            "kernel module $module is not loaded and $path does not exist: $effect"
        return 1
    fi
    if ! output="$(insmod "$path" 2>&1)"; then
        report_module_failure "$level" \
            "failed to load kernel module $path${output:+ ($output)}: $effect"
        return 2
    fi
    log "Loaded kernel module $path"
}

report_module_failure() {
    case "$1" in
        required) log_error "$2" ;;
        optional) log_warn "$2" ;;
    esac
}

ipset_hash_net_available() {
    command -v ipset >/dev/null 2>&1 || return 1

    if ipset create "$IPSET_PROBE_SET" hash:net family inet -exist >/dev/null 2>&1; then
        ipset destroy "$IPSET_PROBE_SET" >/dev/null 2>&1 || true
        return 0
    fi

    ipset destroy "$IPSET_PROBE_SET" >/dev/null 2>&1 || true
    return 1
}

check_netfilter_addons_component() {
    local components component

    if ! components="$(wget -O - localhost:79/rci/show/version/ndw/components 2>/dev/null)"; then
        log_error "Failed to fetch installed Keenetic components"
        return 0
    fi

    # opkg-kmod-netfilter: Netfilter Subsystem Kernel Modules (nfnetlink_queue,
    # xt_NFQUEUE, xt_NFLOG, xt_connbytes, ...).  opkg-kmod-netfilter-addons:
    # Xtables-addons Extension Package for Netfilter.
    for component in opkg-kmod-netfilter opkg-kmod-netfilter-addons; do
        case ",$components," in
            *,"$component",*)
                ;;
            *)
                log_error "Missing Keenetic component $component"
                ;;
        esac
    done
    return 0
}

wait_for_keenetic_rci() {
    local attempt=1

    while [ "$attempt" -le "$KEENETIC_RCI_STARTUP_ATTEMPTS" ]; do
        if wget -O /dev/null localhost:79/rci/show/version 2>/dev/null; then
            if [ "$attempt" -gt 1 ]; then
                log "Keenetic RCI became available after $attempt attempts"
            fi
            return 0
        fi

        if [ "$attempt" -lt "$KEENETIC_RCI_STARTUP_ATTEMPTS" ]; then
            log "Keenetic RCI is unavailable (attempt $attempt/$KEENETIC_RCI_STARTUP_ATTEMPTS); retrying in 1 second"
            sleep 1
        fi
        attempt=$((attempt + 1))
    done

    log_error "Keenetic RCI is still unavailable after $KEENETIC_RCI_STARTUP_ATTEMPTS attempts; continuing startup"
    return 0
}

ensure_ipset_modules_loaded() {
    local module

    if ! ipset_hash_net_available; then
        for module in nfnetlink ip_set ip_set_hash_net; do
            load_kernel_module required "$module" "" "ipset lists are unavailable" || break
        done
        ipset_hash_net_available ||
            log_error "$IPSET_COMPONENTS_MESSAGE Required probe failed: ipset create $IPSET_PROBE_SET hash:net family inet -exist"
    fi
    load_kernel_module required xt_set /proc/net/ip_tables_matches:set \
        "routing rules cannot match ipset lists"
}

# Rule matches used only by some configs; the daemon reports rules that fail
# to apply.
ensure_rule_match_modules_loaded() {
    load_kernel_module optional xt_multiport /proc/net/ip_tables_matches:multiport \
        "rules with port lists cannot be applied"
    load_kernel_module optional xt_dscp /proc/net/ip_tables_matches:dscp \
        "rules with DSCP matches cannot be applied"
    # Without it the daemon falls back to plain -d broadcast/multicast matches.
    load_kernel_module optional xt_addrtype /proc/net/ip_tables_matches:addrtype \
        "router-output broadcast/multicast skips use plain destination matches"
}

# DNS hold (NFQUEUE, conntrack) and L7 capture (NFLOG, connbytes).  Loaded
# only here, at service start; a missing module degrades interception (the
# daemon reports it in /api/health/service) but never stops the service.
ensure_intercept_modules_loaded() {
    local effect="DNS/L7 interception is unavailable; install the Keenetic component opkg-kmod-netfilter (Netfilter Subsystem Kernel Modules)"

    load_kernel_module optional nfnetlink_queue /proc/net/netfilter/nfnetlink_queue: "$effect"
    load_kernel_module optional xt_NFQUEUE /proc/net/ip_tables_targets:NFQUEUE "$effect"
    load_kernel_module optional xt_conntrack /proc/net/ip_tables_matches:conntrack "$effect"
    load_kernel_module optional nfnetlink_log /proc/net/netfilter/nfnetlink_log: "$effect"
    load_kernel_module optional xt_NFLOG /proc/net/ip_tables_targets:NFLOG "$effect"
    load_kernel_module optional xt_connbytes /proc/net/ip_tables_matches:connbytes "$effect"
    return 0
}

check_runtime_dependencies() {
    check_netfilter_addons_component
    ensure_ipset_modules_loaded
    ensure_rule_match_modules_loaded
    ensure_intercept_modules_loaded
}

remove_daemon_arg() {
    local target="$1"
    local arg
    local filtered=""
    for arg in $ARGS; do
        [ "$arg" = "$target" ] || filtered="$filtered $arg"
    done
    ARGS="$filtered"
}

ipv6_runtime_enabled() {
    [ ! -r /proc/sys/net/ipv6/conf/all/disable_ipv6 ] ||
        [ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null)" != "1" ]
}

keen_pbr_ipv6_enabled() {
    # Config is JSON and the generated schema uses daemon.ipv6_enabled.  A
    # missing key retains the enabled default; an explicit false disables the
    # forced IPv6 RAW requirement just like the daemon's resolver decision.
    grep -Eq '"ipv6_enabled"[[:space:]]*:[[:space:]]*false' "$CONFIG" 2>/dev/null &&
        return 1
    ipv6_runtime_enabled
}

# Probe one family independently.  The registry check prevents trusting an
# on-disk module, while the command probe remains authoritative after insmod.
raw_family_available() {
    local family="$1"
    local command registry module rc
    RAW_FAMILY_PROBE_REASON=""
    if [ "$family" = "ipv6" ]; then
        command="ip6tables"
        registry="/proc/net/ip6_tables_names"
        module="ip6table_raw"
    else
        command="iptables"
        registry="/proc/net/ip_tables_names"
        module="iptable_raw"
    fi

    if grep -qx raw "$registry" 2>/dev/null &&
       "$command" -t raw -S >/dev/null 2>&1; then
        return 0
    fi
    load_kernel_module probe "$module" "" ""
    rc=$?
    if ! grep -qx raw "$registry" 2>/dev/null; then
        case "$rc" in
            1) RAW_FAMILY_PROBE_REASON="module missing: $(module_path_for "$module")" ;;
            2) RAW_FAMILY_PROBE_REASON="module load failed: $(module_path_for "$module")" ;;
            *) RAW_FAMILY_PROBE_REASON="module loaded but raw is absent from $registry" ;;
        esac
        return 1
    fi
    if ! "$command" -t raw -S >/dev/null 2>&1; then
        RAW_FAMILY_PROBE_REASON="raw registered in $registry but $command -t raw -S failed"
        return 1
    fi
}

enable_raw_prerouting_if_available() {
    local raw_mode raw4=0 raw6=0 ipv6_enabled=0

    # Remove both legacy/persisted daemon flags before resolving policy.
    remove_daemon_arg --use-raw-prerouting
    remove_daemon_arg --use-raw6-prerouting

    raw_mode="${KEEN_PBR_RAW_PREROUTING:-auto}"
    case "$raw_mode" in
        auto|enable|disable|ipv4-only|ipv6-only) ;;
        *)
            log_warn "invalid KEEN_PBR_RAW_PREROUTING=${KEEN_PBR_RAW_PREROUTING}; using auto"
            raw_mode="auto"
            ;;
    esac
    [ "$raw_mode" = "disable" ] && {
        log "RAW PREROUTING disabled; using mangle for IPv4 and IPv6"
        return 0
    }
    keen_pbr_ipv6_enabled && ipv6_enabled=1

    case "$raw_mode" in
        auto|enable|ipv4-only)
            if raw_family_available ipv4; then
                raw4=1
                log "IPv4 raw PREROUTING available"
            else
                log_warn "IPv4 raw PREROUTING unavailable: $RAW_FAMILY_PROBE_REASON"
            fi
            ;;
    esac
    case "$raw_mode" in
        auto|enable|ipv6-only)
            if [ "$ipv6_enabled" = 1 ] && raw_family_available ipv6; then
                raw6=1
                log "IPv6 raw PREROUTING available"
            elif [ "$ipv6_enabled" = 1 ]; then
                log_warn "IPv6 raw PREROUTING unavailable: $RAW_FAMILY_PROBE_REASON"
            else
                log "IPv6 disabled; skipping IPv6 raw capability requirement"
            fi
            ;;
    esac

    case "$raw_mode" in
        auto)
            [ "$raw4" = 1 ] && ARGS="$ARGS --use-raw-prerouting"
            [ "$raw6" = 1 ] && ARGS="$ARGS --use-raw6-prerouting"
            ;;
        enable)
            # Forced modes deliberately pass unavailable flags through so the
            # daemon's authoritative C++ validation fails startup clearly.
            ARGS="$ARGS --use-raw-prerouting"
            [ "$ipv6_enabled" = 1 ] && ARGS="$ARGS --use-raw6-prerouting"
            ;;
        ipv4-only)
            ARGS="$ARGS --use-raw-prerouting"
            ;;
        ipv6-only)
            [ "$ipv6_enabled" = 1 ] && ARGS="$ARGS --use-raw6-prerouting"
            ;;
    esac
}

enable_hwnat() {
    log "Enabling HW NAT..."
    sysctl -w net.ipv4.netfilter.ip_conntrack_fastnat=1 2>/dev/null || true
    sysctl -w net.netfilter.nf_conntrack_fastnat=1 2>/dev/null || true
}

disable_hwnat() {
    log "Disabling HW NAT..."
    sysctl -w net.ipv4.netfilter.ip_conntrack_fastnat=0 2>/dev/null || true
    sysctl -w net.netfilter.nf_conntrack_fastnat=0 2>/dev/null || true
}

signal_service() {
    local signal="$1"
    local pid

    if [ ! -s "$PIDFILE" ]; then
        log_error "Cannot send $signal to keen-pbr: PID file $PIDFILE is missing or empty"
        return 1
    fi

    read -r pid < "$PIDFILE"
    if [ -z "$pid" ]; then
        log_error "Cannot send $signal to keen-pbr: PID file $PIDFILE does not contain a PID"
        return 1
    fi

    if ! kill "-$signal" "$pid"; then
        log_error "Failed to send $signal to keen-pbr PID $pid from $PIDFILE"
        return 1
    fi

    log "Sent $signal to keen-pbr PID $pid"

    return 0
}

pidof() {
    local pid
    [ "$1" = "$PROCS" ] || { command pidof "$@"; return $?; }
    [ -s "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE") || return 1
    [ -d "/proc/$pid" ] || return 1
    printf '%s\n' "$pid"
}

prepare_start() {
    wait_for_keenetic_rci
    check_runtime_dependencies
    enable_raw_prerouting_if_available
    disable_hwnat
}

prepare_stop() {
    enable_hwnat
}

case "$1" in
    reload)
        signal_service HUP
        exit $?
        ;;
    reapply-firewall)
        signal_service SIGUSR1
        exit $?
        ;;
    start|restart|restartall)
        prepare_start
        ;;
    stop|kill)
        prepare_stop
        ;;
esac

. /opt/etc/init.d/rc.func
