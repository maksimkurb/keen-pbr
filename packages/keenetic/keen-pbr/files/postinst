#!/bin/sh

echo "keen-pbr installation"
echo "------------------------"

mkdir -p /opt/usr/lib/keen-pbr

# keen-pbr no longer touches dnsmasq on install: the dnsmasq integration is
# optional (dns.resolver_integration = "dnsmasq" in config.json).  The daemon
# installs its conf-script block itself (dnsmasq.sh activate) when the
# integration is enabled, so an existing setup keeps working after an upgrade.
# To apply the recommended dnsmasq base config manually, run:
#   /opt/usr/lib/keen-pbr/dnsmasq.sh install-defaults

echo ""
/opt/etc/init.d/S80keen-pbr start || echo "Failed to start keen-pbr service"
echo ""

echo "Installation complete!"
echo "Config path: /opt/etc/keen-pbr/config.json"
echo "Web API: http://my.keenetic.net:12121"

exit 0
