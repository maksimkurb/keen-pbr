#!/bin/sh

echo "keen-pbr installation"
echo "------------------------"

mkdir -p /opt/usr/lib/keen-pbr

if [ "$PKG_UPGRADE" = "1" ] && ! grep -q '"version"' /opt/etc/keen-pbr/config.json 2>/dev/null; then
    echo "What's new in 3.4.0: https://keen-pbr.fyi/docs/changelog/#v3-4-0"
fi

echo ""
# restart, not start: when the old package's prerm could not stop its daemon,
# start would report "already running" and leave the old binary serving.
/opt/etc/init.d/S80keen-pbr restart || echo "Failed to start keen-pbr service"
echo ""

echo "Installation complete!"
echo "Config path: /opt/etc/keen-pbr/config.json"
echo "Web API: http://my.keenetic.net:12121"

exit 0
