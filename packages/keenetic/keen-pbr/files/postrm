#!/bin/sh

cat <<'EOF'
keen-pbr has been removed.
keen-pbr does not manage your DNS resolver any more. If upstream DNS servers are
not configured in your dnsmasq settings, internet access may stop working.
Configure upstream DNS servers manually if they are not set yet.

Hint: add "server=8.8.8.8" (or other DNS servers) to the /opt/etc/dnsmasq.conf file.
EOF

exit 0
