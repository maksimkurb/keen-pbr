#!/bin/sh

echo "Stopping keen-pbr service..."
/opt/etc/init.d/S80keen-pbr stop || true

# prerm also runs on upgrade (opkg); the daemon re-applies the integration
# after start, so removing it here is harmless and keeps uninstall clean.
/opt/usr/lib/keen-pbr/dnsmasq-hook.sh remove >/dev/null 2>&1 || true

# If dnsmasq migration is needed during uninstall, run it to clean up the configuration.
# This is idempotent and safe.
/opt/usr/lib/keen-pbr/migrate-dnsmasq.sh >/dev/null 2>&1 || true

exit 0
