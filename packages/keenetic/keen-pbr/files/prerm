#!/bin/sh
# Never runs keen-pbr itself (a broken binary or config must not block or
# break the removal) and never fails: every step is best effort.

echo "Stopping keen-pbr service..."
/opt/etc/init.d/S80keen-pbr stop || true

# On an upgrade the conf-script entry stays and the new daemon re-applies its
# firewall state, so only the service is stopped.
if [ "$PKG_UPGRADE" = 1 ] || [ "$1" = upgrade ]; then
    exit 0
fi

# Remove keen-pbr from dnsmasq's config and keep dnsmasq resolving.
/opt/usr/lib/keen-pbr/dnsmasq-hook.sh uninstall >/dev/null 2>&1 || true

# Remove firewall rules a crashed daemon may have left behind.
/opt/usr/lib/keen-pbr/cleanup-firewall.sh >/dev/null 2>&1 || true

exit 0
