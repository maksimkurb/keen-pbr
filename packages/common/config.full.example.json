{
  "device_name": "",
  "daemon": {
    "pid_file": "/var/run/keen-pbr.pid",
    "cache_dir": "/var/cache/keen-pbr",
    "strict_enforcement": false
  },

  "api": {
    "enabled": true,
    "listen": "0.0.0.0:12121"
  },

  "outbounds": [
    {
      "type": "table",
      "tag": "wan",
      "table": 254
    },
    {
      "type": "blackhole",
      "tag": "block"
    }
  ],

  "lists": {
    "local_list": {
      "domains": [
        "example.com"
      ],
      "ip_cidrs": [
        "93.184.216.34",
        "10.0.0.0/8"
      ]
    }
  },

  "dns": {
    "resolver_integration": "none",
    "servers": [
      {
        "tag": "quad9",
        "address": "9.9.9.9"
      }
    ],
    "rules": [],
    "fallback": ["quad9"]
  },

  "fwmark": {
    "start": "0x00010000",
    "mask": "0x00FF0000"
  },

  "iproute": {
    "table_start": 150
  },

  "lists_autoupdate": {
    "enabled": true,
    "cron": "0 4 * * 0"
  },

  "route": {
    "rules": []
  }
}
