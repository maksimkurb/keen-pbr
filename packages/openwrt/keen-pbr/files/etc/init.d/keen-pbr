#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

if type extra_command >/dev/null 2>&1; then
    extra_command "reapply_firewall" " Send SIGUSR1 to the running service"
    extra_command "sync_firewall_hook" " Ensure the fw4 include exists for keen-pbr"
    extra_command "remove_firewall_hook" " Remove the fw4 include for keen-pbr"
else
    EXTRA_COMMANDS="reapply_firewall sync_firewall_hook remove_firewall_hook"
    EXTRA_HELP="        reapply_firewall        Send SIGUSR1 to the running service
        sync_firewall_hook      Ensure the fw4 include exists for keen-pbr
        remove_firewall_hook    Remove the fw4 include for keen-pbr"
fi

PROG=/usr/sbin/keen-pbr
CONFIG=/etc/keen-pbr/config.json
UCI_HELPER=/usr/lib/keen-pbr/uci.sh
PIDFILE=/var/run/keen-pbr.pid
CLEANUP_FIREWALL=/usr/lib/keen-pbr/cleanup-firewall.sh
STOP_WAIT_SECONDS=15

script_name() {
    basename "${initscript:-$0}"
}

rc_root() {
    printf '%s' "${IPKG_INSTROOT:-}"
}

start_link_path() {
    printf '%s/etc/rc.d/S%02d%s' "$(rc_root)" "$START" "$(script_name)"
}

stop_link_path() {
    printf '%s/etc/rc.d/K%02d%s' "$(rc_root)" "$STOP" "$(script_name)"
}

ensure_fw4_include() {
    [ -x "$UCI_HELPER" ] || return 1
    "$UCI_HELPER" firewall-sync
}

remove_fw4_include() {
    [ -x "$UCI_HELPER" ] || return 1
    "$UCI_HELPER" firewall-remove
}

is_enabled() {
    [ -L "$(start_link_path)" ] || [ -L "$(stop_link_path)" ]
}

enable() {
    local root name

    root="$(rc_root)"
    name="$(script_name)"

    mkdir -p "$root/etc/rc.d"
    ln -sf "../init.d/${name}" "$(start_link_path)"
    ln -sf "../init.d/${name}" "$(stop_link_path)"

    [ -n "$IPKG_INSTROOT" ] && return 0

    ensure_fw4_include || return 1

}

disable() {
    rm -f "$(start_link_path)" "$(stop_link_path)"

    [ -n "$IPKG_INSTROOT" ] && return 0

    remove_fw4_include || return 1
}

start_service() {
    [ -x "$PROG" ] || return 1
    [ -f "$CONFIG" ] || return 1

    ensure_fw4_include || return 1

    mkdir -p /var/cache/keen-pbr /var/run/keen-pbr

    procd_open_instance
    procd_set_param command "$PROG" --config "$CONFIG" --pid-file "$PIDFILE" --log-target syslog service
    procd_set_param respawn
    procd_close_instance
}

daemon_alive() {
    local pid

    [ -s "$PIDFILE" ] || return 1
    read -r pid < "$PIDFILE" || return 1
    [ -n "$pid" ] && [ -d "/proc/$pid" ]
}

# procd calls this after it was asked to stop the instance, without waiting
# for the process to exit.  A clean stop removes the firewall rules and then
# the PID file; after kill -9 or a crash the rules are still there, and
# cleanup-firewall.sh removes them (logging a warning).  It runs only once no
# keen-pbr is alive: it would otherwise pull the rules from under it.
service_stopped() {
    local waited=0

    while daemon_alive; do
        if [ "$waited" -ge "$STOP_WAIT_SECONDS" ]; then
            logger -t keen-pbr -p user.warning \
                "keen-pbr is still running after stop; its firewall rules are left in place"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    [ -x "$CLEANUP_FIREWALL" ] && "$CLEANUP_FIREWALL" --reason stop
    return 0
}

reload_service() {
    [ -s "$PIDFILE" ] || return 1

    kill -HUP "$(cat "$PIDFILE")"
}

reapply_firewall() {
    [ -s "$PIDFILE" ] || return 1
    kill -SIGUSR1 "$(cat "$PIDFILE")"
}

sync_firewall_hook() {
    ensure_fw4_include
}

remove_firewall_hook() {
    remove_fw4_include
}
