#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

if type extra_command >/dev/null 2>&1; then
    extra_command "reapply_firewall" " Send SIGUSR1 to the running service"
    extra_command "reapply_dnsmasq_config" " Regenerate keen-pbr dnsmasq config and restart dnsmasq"
    extra_command "sync_firewall_hook" " Ensure the fw4 include exists for keen-pbr"
    extra_command "remove_firewall_hook" " Remove the fw4 include for keen-pbr"
else
    EXTRA_COMMANDS="reapply_firewall reapply_dnsmasq_config sync_firewall_hook remove_firewall_hook"
    EXTRA_HELP="        reapply_firewall        Send SIGUSR1 to the running service
        reapply_dnsmasq_config  Regenerate keen-pbr dnsmasq config and restart dnsmasq
        sync_firewall_hook      Ensure the fw4 include exists for keen-pbr
        remove_firewall_hook    Remove the fw4 include for keen-pbr"
fi

PROG=/usr/sbin/keen-pbr
CONFIG=/etc/keen-pbr/config.json
HELPER=/usr/lib/keen-pbr/dnsmasq.sh
UCI_HELPER=/usr/lib/keen-pbr/uci.sh
PIDFILE=/var/run/keen-pbr.pid

script_name() {
    basename "${initscript:-$0}"
}

rc_root() {
    printf '%s' "${IPKG_INSTROOT:-}"
}

start_link_path() {
    printf '%s/etc/rc.d/S%02d%s' "$(rc_root)" "$START" "$(script_name)"
}

stop_link_path() {
    printf '%s/etc/rc.d/K%02d%s' "$(rc_root)" "$STOP" "$(script_name)"
}

ensure_fw4_include() {
    [ -x "$UCI_HELPER" ] || return 1
    "$UCI_HELPER" firewall-sync
}

remove_fw4_include() {
    [ -x "$UCI_HELPER" ] || return 1
    "$UCI_HELPER" firewall-remove
}

# The dnsmasq integration is optional.  It is on when config.json sets
# dns.resolver_integration to "dnsmasq", or, for configs written before the
# option existed, when dns.system_resolver is configured.
resolver_integration_enabled() {
    [ -r "$CONFIG" ] || return 1
    if grep -Eq '"resolver_integration"[[:space:]]*:' "$CONFIG"; then
        grep -Eq '"resolver_integration"[[:space:]]*:[[:space:]]*"dnsmasq"' "$CONFIG"
        return $?
    fi
    grep -Eq '"system_resolver"[[:space:]]*:' "$CONFIG"
}

is_enabled() {
    [ -L "$(start_link_path)" ] || [ -L "$(stop_link_path)" ]
}

enable() {
    local root name

    root="$(rc_root)"
    name="$(script_name)"

    mkdir -p "$root/etc/rc.d"
    ln -sf "../init.d/${name}" "$(start_link_path)"
    ln -sf "../init.d/${name}" "$(stop_link_path)"

    [ -n "$IPKG_INSTROOT" ] && return 0

    ensure_fw4_include || return 1

    # The dnsmasq integration (conf-script, jail mounts) is installed by the
    # daemon itself (dnsmasq.sh activate) when it is enabled in config.json.
}

disable() {
    rm -f "$(start_link_path)" "$(stop_link_path)"

    [ -n "$IPKG_INSTROOT" ] && return 0

    remove_fw4_include || return 1

    if [ -x "$HELPER" ]; then
        "$HELPER" uninstall-persistent || return 1
    fi
}

start_service() {
    [ -x "$PROG" ] || return 1
    [ -f "$CONFIG" ] || return 1

    ensure_fw4_include || return 1

    mkdir -p /var/cache/keen-pbr /var/run/keen-pbr

    if resolver_integration_enabled && [ -x "$HELPER" ]; then
        "$HELPER" prepare || return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" --config "$CONFIG" --pid-file "$PIDFILE" --log-target syslog service
    procd_set_param respawn
    procd_close_instance
}

reload_service() {
    [ -s "$PIDFILE" ] || return 1

    kill -HUP "$(cat "$PIDFILE")"
}

reapply_firewall() {
    [ -s "$PIDFILE" ] || return 1
    kill -SIGUSR1 "$(cat "$PIDFILE")"
}

reapply_dnsmasq_config() {
    resolver_integration_enabled || return 0
    if [ -x "$HELPER" ]; then
        "$HELPER" reload || return 1
    fi
}

sync_firewall_hook() {
    ensure_fw4_include
}

remove_firewall_hook() {
    remove_fw4_include
}
