#!/bin/sh

[ -n "$IPKG_INSTROOT" ] && exit 0

# Migrate from dnsmasq integration: restore kpbr_server back to server list.
# This is idempotent and safe to call even if the integration was never used.
/usr/lib/keen-pbr/uci.sh dnsmasq-migrate-from-keen-pbr >/dev/null 2>&1 || true

/etc/init.d/keen-pbr sync_firewall_hook >/dev/null 2>&1 || true

if [ "$PKG_UPGRADE" = "1" ] && /etc/init.d/keen-pbr running >/dev/null 2>&1; then
    /etc/init.d/keen-pbr restart || exit 1
fi

exit 0
