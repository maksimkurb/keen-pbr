#!/bin/sh

[ -n "$IPKG_INSTROOT" ] && exit 0

# opkg does not tell a postinst the old version, so the check is the config:
# a config written by 3.3.x has no "version" field.
KEEN_PBR_CONFIG="/etc/keen-pbr/config.json"
if [ "$PKG_UPGRADE" = "1" ] && [ -f "$KEEN_PBR_CONFIG" ] && ! grep -q '"version"' "$KEEN_PBR_CONFIG"; then
    echo "What's new in 3.4.0: https://keen-pbr.fyi/docs/changelog/#v3-4-0"
fi

# Rewrites keen-pbr's dnsmasq entry in /tmp at boot, before dnsmasq starts.
[ -e /etc/rc.d/S18keen-pbr-dnsmasq ] || /etc/init.d/keen-pbr-dnsmasq enable >/dev/null 2>&1 || true

/etc/init.d/keen-pbr sync_firewall_hook >/dev/null 2>&1 || true

if [ "$PKG_UPGRADE" = "1" ] && /etc/init.d/keen-pbr running >/dev/null 2>&1; then
    /etc/init.d/keen-pbr restart || exit 1
fi

exit 0
