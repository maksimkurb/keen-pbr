table inet KeenPbrTable {
	set kpbr4_x {
		type ipv4_addr
		flags interval
		elements = { 10.0.0.0/8, 192.0.2.1 }
	}

	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		tcp dport { 22-25, 80-81, 443, 8000-9500 } accept
		ip daddr { 8.8.8.8, 9.9.9.9, 10.0.0.0/8 } accept
		ip daddr 1.2.3.4 accept
		ip saddr 10.0.0.0/8 accept
		ip6 daddr 2001:db8::/64 accept
		ip dscp ef accept
		ip dscp 0x07 accept
		ip dscp cs1 accept
		meta mark set 0x00000005 accept
		meta mark set meta mark & 0xff01ffff | 0x00010000 accept
		iifname { "br0", "lan0" } accept
		ct state { established, related } accept
		ct status dnat accept
		meta mark != 0x00000000 accept
		meta mark & 0x000000ff == 0x00000010 accept
		tcp dport != { 80, 443 } accept
		meta l4proto { tcp, udp } accept
		ip saddr . tcp dport { 1.2.3.4 . 80 } accept
		limit rate 1/second burst 5 packets accept
		ip daddr @kpbr4_x jump setmark_00000010
		goto setmark_00000010
		return
	}

	chain setmark_00000010 {
	}
}
