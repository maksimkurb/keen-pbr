-P PREROUTING ACCEPT
-P INPUT ACCEPT
-P FORWARD ACCEPT
-P OUTPUT ACCEPT
-P POSTROUTING ACCEPT
-N KeenPbrOutput
-N KeenPbrOutput_B
-N _NDM_BACKUP_DNAT
-N _NDM_BACKUP_FORWARD
-N _NDM_DNSRT_PREROUTING_MANGLE
-N _NDM_HOTSPOT_PREROUTING_MANGL
-N _NDM_HTTP_INPUT_TLS_
-N _NDM_HTTP_INPUT_TLS_PASS_
-N _NDM_IPSEC_OUTPUT_MANGLE
-N _NDM_IPSEC_PREROUTING
-N _NDM_OUTPUT_DELAY
-N _NDM_PREROUTING_MC
-N _NDM_VPN_PREROUTING
-N _NDM_WGOBFS_IN
-N _NDM_WGOBFS_OUT
-A PREROUTING -d 224.0.0.0/4 -j _NDM_PREROUTING_MC
-A PREROUTING -j _NDM_IPSEC_PREROUTING
-A PREROUTING -j _NDM_VPN_PREROUTING
-A PREROUTING -j _NDM_HOTSPOT_PREROUTING_MANGL
-A PREROUTING -m mark --mark 0x0 -j _NDM_DNSRT_PREROUTING_MANGLE
-A INPUT -p udp -j _NDM_WGOBFS_IN
-A INPUT -m state --state RELATED,ESTABLISHED -m connndmmark --mark 0x20/0x0 -j ACCEPT
-A INPUT -p tcp -m tcp --dport 443 -j _NDM_HTTP_INPUT_TLS_
-A FORWARD -j NDMMARK --set-xndmmark 0x4/0x0
-A FORWARD -j _NDM_BACKUP_FORWARD
-A FORWARD -m connskip --connskip 10 -j _NDM_DNS_FORWARD
-A FORWARD -i nwg0 -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
-A OUTPUT -p udp -j _NDM_WGOBFS_OUT
-A OUTPUT -j _NDM_OUTPUT_DELAY
-A OUTPUT -j _NDM_IPSEC_OUTPUT_MANGLE
-A OUTPUT -j KeenPbrOutput
-A KeenPbrOutput -j KeenPbrOutput_B
-A KeenPbrOutput_B -m conntrack --ctdir ORIGINAL -m connmark ! --mark 0x0/0xff0000 -j CONNMARK --restore-mark --nfmask 0xff0000 --ctmask 0xff0000
-A KeenPbrOutput_B -m conntrack --ctdir ORIGINAL -m mark ! --mark 0x0/0xff0000 -j RETURN
-A KeenPbrOutput_B -m conntrack --ctstate DNAT -j RETURN
-A KeenPbrOutput_B -m mark ! --mark 0x0 -j ACCEPT
-A KeenPbrOutput_B ! -i br0 -j RETURN
-A KeenPbrOutput_B -m dscp --dscp 0x2c -j MARK --set-xmark 0x10000/0xff0000
-A KeenPbrOutput_B -m dscp --dscp 0x2c -j CONNMARK --save-mark --nfmask 0xff0000 --ctmask 0xff0000
-A KeenPbrOutput_B -m dscp --dscp 0x2c -j RETURN
-A KeenPbrOutput_B -m set --match-set kpbr4S_vpn_local dst -j MARK --set-xmark 0x50000/0xff0000
-A KeenPbrOutput_B -m set --match-set kpbr4S_vpn_local dst -j CONNMARK --save-mark --nfmask 0xff0000 --ctmask 0xff0000
-A KeenPbrOutput_B -m set --match-set kpbr4S_vpn_local dst -j RETURN
-A KeenPbrOutput_B -m set --match-set kpbr4d_vpn_local dst -j MARK --set-xmark 0x50000/0xff0000
-A KeenPbrOutput_B -m set --match-set kpbr4d_vpn_local dst -j CONNMARK --save-mark --nfmask 0xff0000 --ctmask 0xff0000
-A KeenPbrOutput_B -m set --match-set kpbr4d_vpn_local dst -j RETURN
-A KeenPbrOutput_B -m set --match-set kpbr4d_direct dst -j MARK --set-xmark 0x10000/0xff0000
-A KeenPbrOutput_B -m set --match-set kpbr4d_direct dst -j CONNMARK --save-mark --nfmask 0xff0000 --ctmask 0xff0000
-A KeenPbrOutput_B -m set --match-set kpbr4d_direct dst -j RETURN
-A KeenPbrOutput_B -m set --match-set kpbr4S_minecraft dst -j MARK --set-xmark 0x30000/0xff0000
-A KeenPbrOutput_B -m set --match-set kpbr4S_minecraft dst -j CONNMARK --save-mark --nfmask 0xff0000 --ctmask 0xff0000
-A KeenPbrOutput_B -m set --match-set kpbr4S_minecraft dst -j RETURN
-A _NDM_BACKUP_DNAT -m conntrack --ctstate DNAT -j CONNNDMMARK --set-xmark 0x80/0x0
-A _NDM_BACKUP_FORWARD -m connndmmark --mark 0x80/0x0 -j CONNNDMMARK --set-xmark 0x80/0x0
-A _NDM_HOTSPOT_PREROUTING_MANGL -m mac --mac-source 02:00:00:00:00:01 -j RETURN
-A _NDM_HOTSPOT_PREROUTING_MANGL -m mac --mac-source 02:00:00:00:00:02 -j MARK --set-xmark 0xffffaab/0xffffffff
-A _NDM_HOTSPOT_PREROUTING_MANGL -m mac --mac-source 02:00:00:00:00:02 -j CONNMARK --save-mark --nfmask 0xffffffff --ctmask 0xffffffff
-A _NDM_HOTSPOT_PREROUTING_MANGL -m mac --mac-source 02:00:00:00:00:02 -j RETURN
-A _NDM_HTTP_INPUT_TLS_ -p tcp -m tcp --dport 443 --tcp-flags ACK ACK -m connskip --connskip 2 -j RETURN
-A _NDM_HTTP_INPUT_TLS_PASS_ -p tcp -m tls  --tls-sni "*example.keenetic.io" -j CONNNDMMARK --set-xmark 0x0/0x0
-A _NDM_HTTP_INPUT_TLS_PASS_ -j DROP
-A _NDM_IPSEC_PREROUTING -m policy --dir in --pol ipsec -j NDMMARK --set-xndmmark 0x0/0x0
-A _NDM_VPN_PREROUTING -j _NDM_PPTPSRVVPN_MARK
