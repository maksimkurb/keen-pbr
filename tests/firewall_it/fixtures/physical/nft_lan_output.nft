table inet KeenPbrTable {
	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		ct direction original ct mark & 0x00ff0000 != 0x00000000 ct mark & 0x00ff0000 vmap { 0x00010000 : jump setmark_00010000 } ct mark & 0x00ff0000 == 0x00010000 accept comment "kpbr:v1:prefilter.restore_conntrack_mark:9a8c6f9a29c8dccb68b5fc837b14b28a"
		ct direction reply counter packets 0 bytes 0 accept comment "kpbr:v1:prefilter.skip_local_replies:7257c668d9bf18a9c15001249e18c1ef"
		iifname != { "br-guest", "lan0" } counter packets 0 bytes 0 accept comment "kpbr:v1:prefilter.inbound_interface_filter:8162b5ecab9ca5e73deaf622224213dd"
		meta nfproto ipv4 meta l4proto udp counter packets 0 bytes 0 jump setmark_00010000 comment "kpbr:v1:route.mark:f07ef83f847846c4de79471f383975ed"
	}

	chain output {
		type route hook output priority mangle; policy accept;
		ct direction original ct mark & 0x00ff0000 != 0x00000000 ct mark & 0x00ff0000 vmap { 0x00010000 : jump setmark_00010000 } ct mark & 0x00ff0000 == 0x00010000 accept comment "kpbr:v1:prefilter.restore_conntrack_mark:9a8c6f9a29c8dccb68b5fc837b14b28a"
		ct direction reply counter packets 0 bytes 0 accept comment "kpbr:v1:prefilter.skip_local_replies:7257c668d9bf18a9c15001249e18c1ef"
		oifname { "br-guest", "lan0" } counter packets 0 bytes 0 accept comment "kpbr:v1:prefilter.skip_lan_output:06ce507128315d7be7a913aae5be9030"
		fib daddr type broadcast counter packets 0 bytes 0 accept comment "kpbr:v1:prefilter.skip_lan_output:d05fe17c7e7d461adfa47552c0ac3ea9"
		fib daddr type multicast counter packets 0 bytes 0 accept comment "kpbr:v1:prefilter.skip_lan_output:8175d477c978e62e1e2a753d822a3652"
		meta nfproto ipv4 meta l4proto udp counter packets 0 bytes 0 jump setmark_00010000 comment "kpbr:v1:route.mark:f07ef83f847846c4de79471f383975ed"
	}

	chain setmark_00010000 {
		meta mark set meta mark & 0xff01ffff | 0x00010000 ct mark set ct mark & 0xff01ffff | 0x00010000 accept
	}
}
