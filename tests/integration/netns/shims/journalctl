#!/usr/bin/env bash
set -euo pipefail
: "${KPBR_RUNTIME:?}"

pattern=""
has_since=0
want_keen=0
want_dns=0
args=("$@")
i=0
while ((i < ${#args[@]})); do
  case "${args[$i]}" in
    -g)
      ((i+=1)); pattern=${args[$i]} ;;
    --grep=*) pattern=${args[$i]#*=} ;;
    --since=*) has_since=1 ;;
    -u)
      ((i+=1))
      case "${args[$i]}" in
        keen-pbr.service|keen-pbr) want_keen=1 ;;
        dnsmasq.service|dnsmasq) want_dns=1 ;;
      esac
      ;;
  esac
  ((i+=1))
done

[[ $want_keen == 1 || $want_dns == 1 ]] || { want_keen=1; want_dns=1; }
files=()
[[ $want_keen == 1 ]] && files+=("$KPBR_RUNTIME/keen-pbr.log")
[[ $want_dns == 1 ]] && files+=("$KPBR_RUNTIME/dnsmasq.log")

for file in "${files[@]}"; do
  [[ -r "$file" ]] || continue
  if [[ $has_since == 1 && "$file" == "$KPBR_RUNTIME/keen-pbr.log" && -r "$KPBR_RUNTIME/journal-since.offset" ]]; then
    offset=$(cat "$KPBR_RUNTIME/journal-since.offset")
    start=$((offset + 1))
    if [[ -n "$pattern" ]]; then
      tail -c "+$start" "$file" | grep -F "$pattern" || true
    else
      tail -c "+$start" "$file"
    fi
  elif [[ -n "$pattern" ]]; then
    grep -F "$pattern" "$file" || true
  else
    cat "$file"
  fi
done
