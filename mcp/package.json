{
  "name": "keen-pbr-mcp",
  "version": "1.0.1",
  "description": "Model Context Protocol server for the keen-pbr REST API",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maksimkurb/keen-pbr.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/maksimkurb/keen-pbr/tree/main/mcp#readme",
  "bugs": {
    "url": "https://github.com/maksimkurb/keen-pbr/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "keen-pbr",
    "keenetic",
    "routing"
  ],
  "type": "module",
  "bin": {
    "keen-pbr-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "openapi-typescript ../docs/openapi.yaml -o src/generated/api-types.ts",
    "prepublishOnly": "npm run build && npm test",
    "postversion": "git commit -m \"chore(mcp): release $npm_package_version\" -- package.json package-lock.json && git tag -a -m \"mcp-$npm_package_version\" \"mcp-$npm_package_version\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
